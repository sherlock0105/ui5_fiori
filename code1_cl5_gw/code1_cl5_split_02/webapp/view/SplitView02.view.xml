<mvc:View
    controllerName="code1.cl505.gw0008.code1cl5split02.controller.SplitView02"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:t="sap.ui.table"
    xmlns="sap.m">

    <Page id="page" title="{i18n>title}">

        <VBox class="sapUiSmallMargin">
            <!-- BKPF Panel -->
            <Panel
                headerText="Accounting Document Header"
                expandable="true"
                expanded="true"
                >

                <t:Table
                    visibleRowCount="5"
                    cellClick="onBseg"
                    rows="{/BkpfSet}"
                    selectionMode="Single"
                    selectionBehavior="RowOnly"
                    paste="onPaste"
                    width="100%">

                    <t:columns>

                        <t:Column width="8rem">
                            <Label text="Company Code" />
                            <t:template>
                                <Text text="{Bukrs}" />
                            </t:template>
                        </t:Column>

                        <t:Column width="10rem">
                            <Label text="Document Number" />
                            <t:template>
                                <Text text="{Belnr}" />
                            </t:template>
                        </t:Column>

                        <t:Column width="6rem">
                            <Label text="Fiscal Year" />
                            <t:template>
                                <Text text="{Gjahr}" />
                            </t:template>
                        </t:Column>

                        <t:Column width="8rem">
                            <Label text="Document Type" />
                            <t:template>
                                <Text text="{Blart}" />
                            </t:template>
                        </t:Column>

                        <t:Column width="6rem">
                            <Label text="Posting Date" />
                            <t:template>
                                <Text text="{Budat}" />
                            </t:template>
                        </t:Column>

                        <t:Column width="8rem">
                            <Label text="Entered On" />
                            <t:template>
                                <Text text="{Cputm}" />
                            </t:template>
                        </t:Column>

                    </t:columns>
                </t:Table>
            </Panel>


            <!--BSEG Panel -->
            <Panel
                headerText="Accounting Document Segment"
                expandable="true"
                expanded="true"
                class="sapUiMediumMarginTop">

                <t:Table
                    id="Bseg"
                    visibleRowCount="5"
                    cellClick="onClick"
                    rows="{/BsegSet}"
                    selectionMode="Single"
                    selectionBehavior="RowOnly"
                    paste="onPaste">

                    <t:columns>

                        <t:Column width="8rem">
                            <Label text="Company Code" />
                            <t:template>
                                <Text text="{Bukrs}" />
                            </t:template>
                        </t:Column>

                        <t:Column width="12rem">
                            <Label text="Document Number" />
                            <t:template>
                                <Text text="{Belnr}" />
                            </t:template>
                        </t:Column>

                        <t:Column width="6rem">
                            <Label text="Fiscal Year" />
                            <t:template>
                                <Text text="{Gjahr}" />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </Panel>
        </VBox>
    </Page>
</mvc:View>