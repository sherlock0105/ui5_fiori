<mvc:View controllerName="code1.cl505gw03.code1cl5gw03.controller.GwCrudView"
    xmlns:t="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:c="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <t:Table
        id="matList"
        rows="{/MatSet}"
        visibleRowCount="7"
        selectionMode="Single"
        selectionBehavior="RowOnly"
        paste="onPaste"
        ariaLabelledBy="title">
        <t:extension>
            <OverflowToolbar style="Clear">
                <Button icon="sap-icon://search" text="Search" press="onSearch"/>
                <ToolbarSpacer width="4rem"/>
                <Input id="IMatnr" placeholder="Matnr" width="6rem" maxLength="40" showClearIcon="true"/>
                <Input id="IAuart" placeholder="Auart" width="10rem" maxLength="4" showClearIcon="true"/>             
            </OverflowToolbar>
        </t:extension>
        <t:columns>
            <t:Column width="10rem">
                <Label text="Material Number" />
                <t:template>
                    <Text text="{Matnr}" wrapping="false" />
                </t:template>
            </t:Column>
            <t:Column width="10rem">
                <Label text="Sales Document Type" />
                <t:template>
                    <Text text="{Auart}" wrapping="false" />
                </t:template>
            </t:Column>
            <t:Column width="10rem">
                <Label text="Sales Organization" />
                <t:template>
                    <Text text="{Vkorg}" wrapping="false" />
                </t:template>
            </t:Column>
            <t:Column width="10rem">
                <Label text="Division" />
                <t:template>
                    <Text text="{Spart}" wrapping="false" />
                </t:template>
            </t:Column>
        </t:columns>
    </t:Table>
    <OverflowToolbar style="Clear">
        <Label text="Contents" width="10rem"/>
        <ToolbarSpacer width="25rem"/>
        <Button icon="sap-icon://eraser" text="Clear" press="onClear" />
        <Button icon="sap-icon://display" text="Display" press="onDisplay"/>
        <Button icon="sap-icon://display" text="Read" press="onRead"/>
        <Button icon="sap-icon://create" text="Create" press="onCreate" />
        <Button icon="sap-icon://edit" text="Update" press="onUpdate" />
        <Button icon="sap-icon://delete" text="Delete" press="onDelete" />
    </OverflowToolbar>
    <f:SimpleForm id="inputForm"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="3"
            labelSpanL="3"
            labelSpanM="3"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="4"
            emptySpanL="4"
            emptySpanM="4"
            emptySpanS="0"
            columnsXL="1"
            columnsL="1"
            columnsM="1"
            singleContainerFullSize="true" >
            <f:content>
                <Label text="Material Number" />
                <Input id="Matnr" width="10rem" maxLength="40"/>

                <Label text="Sales Document Type" />
                <Input id="Auart" width="10rem" maxLength="4"/>

                <Label text="Sales Organization" />
                <Input id="Vkorg" width="10rem" maxLength="4"/>
                
                <Label text="Division" />
                <Input id="Spart" width="10rem" maxLength="2"/>
               
            </f:content>
    </f:SimpleForm>
    </Page>
</mvc:View>