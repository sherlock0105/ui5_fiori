<mvc:View
    controllerName="code1.cl5.cds02.code1cl5cds02.controller.code1_cl5_cds_02"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:t="sap.ui.table"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <t:Table
            visibleRowCount="20"
            cellClick="onClick"
            rows="{/SflightSet}"
            selectionMode="Single"
            selectionBehavior="RowOnly"
            paste="onPaste"
            ariaLabelledBy="title"
        >
            <t:extension>
                <OverflowToolbar style="Clear">
                    <Title
                        id="title"
                        text="Airline"
                    />
                </OverflowToolbar>
            </t:extension>
            <t:columns>
                <t:Column width="5rem">
                    <Label text="Airline" />
                    <t:template>
                        <Text
                            text="{Carrid}"
                            wrapping="false"
                        />
                    </t:template>
                </t:Column>
                <t:Column width="6rem">
                    <Label text="Connection" />
                    <t:template>
                        <Text
                            text="{Connid}"
                            wrapping="false"
                        />
                    </t:template>
                </t:Column>
                <t:Column width="6rem">
                    <Label text="Flight date" />
                    <t:template>
                        <Text
                            text="{fldate}"
                            wrapping="false"
                        />
                    </t:template>
                </t:Column>
                <t:Column width="8rem">
                    <Label text="Price" />
                    <t:template>
                        <Text
                            text="{
                        parts:[{path:'Price'},{path:'Currency'}],
                        type: 'sap.ui.model.type.Unit',
                        formatOptions: {showMeasure: true }
                        }"
                            wrapping="false"
                        />
                    </t:template>
                </t:Column>
                <t:Column width="8rem">
                    <Label text="Paymentsum" />
                    <t:template>
                        <Text
                            text="{
                        parts:[{path:'Paymentsum'},{path:'Currency'}],
                        type: 'sap.ui.model.type.Unit',
                        formatOptions: {showMeasure: true }
                        }"
                            wrapping="false"
                        />
                    </t:template>
                </t:Column>
                <t:Column width="5rem">
                    <Label text="Currency" />
                    <t:template>
                        <Text
                            text="{Currency}"
                            wrapping="false"
                        />
                    </t:template>
                </t:Column>
            </t:columns>
        </t:Table>
    </Page>
</mvc:View>
