<mvc:View
    controllerName="code1.cl5.cds03.code1cl5cds03.controller.ChartView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:m="sap.suite.ui.microchart"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <VBox
            width="30rem"
            height="18rem"
        >
            <m:InteractiveDonutChart
                displayedSegments="10"
                segments="{/CountSet}"
            >
                <m:segments>
                    <m:InteractiveDonutChartSegment
                        label="{Carrid}"
                        value="{=parseFloat(${Cnt})}"
                        displayedValue="{Carrid} / {Cnt}"
                    />
                </m:segments>
            </m:InteractiveDonutChart>
            <m:InteractiveLineChart
                displayedSegments="10"
                points="{/CountSet}"
            >
                <m:points>
                    <m:InteractiveLineChartPoint
                        label="{Carrid}"
                        value="{=parseFloat(${Cnt})}"
                        displayedValue="{Carrid} / {Cnt}"
                    />
                </m:points>
            </m:InteractiveLineChart>
            <m:InteractiveBarChart
                displayedBars="10"
                bars="{/CountSet}"
            >
                <m:bars>
                    <m:InteractiveBarChartBar
                        label="{Carrid}"
                        value="{=parseFloat(${Cnt})}"
                        displayedValue="{Carrid} / {Cnt}"
                    />
                </m:bars>
            </m:InteractiveBarChart>
        </VBox>
    </Page>
</mvc:View>
