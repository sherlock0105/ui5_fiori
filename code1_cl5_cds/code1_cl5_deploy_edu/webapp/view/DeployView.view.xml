<mvc:View controllerName="zcl505.deployedu.code1cl5deployedu.controller.DeployView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:t="sap.ui.table"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
    <Text text="Hello world hihi G" />
    <t:Table
            visibleRowCount = "15"
            id="FlightList"
            rows="{/SflightSet}" 
            selectionMode="Single"
            selectionBehavior="RowOnly"
            paste="onPaste"
            ariaLabelledBy="title">
            <t:extension>
                <OverflowToolbar style="Clear">
                    <Title text="Flight Information"/>
                </OverflowToolbar>
            </t:extension>
            <t:columns>
                <t:Column width="5rem">
                    <Label text="Airline" />
                    <t:template>
                        <Text text="{Carrid}" wrapping="false" />
                    </t:template>
                </t:Column>
                <t:Column width="8rem"> 
                    <Label text="Connection" />
                    <t:template>
                        <Text text="{Connid}" wrapping="false" />
                    </t:template>
                </t:Column>
                <t:Column width="6rem">
                    <Label text="Flight Date" />
                    <t:template>
                        <Text text="{Fldate}" wrapping="false" />
                    </t:template>
                </t:Column>
                <t:Column width="8rem">
                    <Label text="Price" />
                    <t:template>
                        <Text text="{
                            parts:[{path:'Price'},{path:'Currency'}],
                            type: 'sap.ui.model.type.Currency',
                            formatOptions: {showMeasure: true }
                            }" wrapping="false" />
                    </t:template>
                </t:Column>
                <t:Column width="8rem">
                    <Label text="Total Price" />
                    <t:template>
                        <Text text="{
                            parts:[{path:'Paymentsum'},{path:'Currency'}],
                            type: 'sap.ui.model.type.Currency',
                            formatOptions: {showMeasure: true }
                            }" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="6rem">
                    <Label text="Planetype" />
                    <t:template>
                        <Text text="{Planetype}" wrapping="false" />
                    </t:template>
                </t:Column>
            </t:columns>
        </t:Table>
    </Page>
</mvc:View> 