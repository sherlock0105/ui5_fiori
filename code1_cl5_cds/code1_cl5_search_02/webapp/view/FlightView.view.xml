<mvc:View controllerName="code1.cl5.search02.code1cl5search02.controller.FlightView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:t="sap.ui.table"
    xmlns="sap.m">
     <Page id="page" title="{i18n>title}">
     <Button text="Search" press="onSearch" icon="sap-icon://search"/>
    <!-- 값을 받아올 친구 -->
    <Input id="iCarrid" width="4rem" placeholder="Airline" showClearIcon="true"/>
    <Input id="iConnid" width="6rem" placeholder="Connection" showClearIcon="true"/>
    <Input id="iFldate" width="8rem" placeholder="Flight Date" showClearIcon="true"/>
        <t:Table
            visibleRowCount = "15"
            id="FlightList"
            rows="{/SflightSet}" 
            selectionMode="Single"
            selectionBehavior="RowOnly"
            paste="onPaste"
            ariaLabelledBy="title">
            <t:extension>
                <OverflowToolbar style="Clear">
                    <Title text="Flight Information"/>
                </OverflowToolbar>
            </t:extension>
            <t:columns>
                <t:Column width="5rem">
                    <Label text="Airline" />
                    <t:template>
                        <Text text="{Carrid}" wrapping="false" />
                    </t:template>
                </t:Column>
                <t:Column width="8rem"> 
                    <Label text="Connection" />
                    <t:template>
                        <Text text="{Connid}" wrapping="false" />
                    </t:template>
                </t:Column>
                <t:Column width="6rem">
                    <Label text="Flight Date" />
                    <t:template>
                        <Text text="{Fldate}" wrapping="false" />
                    </t:template>
                </t:Column>
                <t:Column width="8rem">
                    <Label text="Price" />
                    <t:template>
                        <Text text="{
                            parts:[{path:'Price'},{path:'Currency'}],
                            type: 'sap.ui.model.type.Currency',
                            formatOptions: {showMeasure: true }
                            }" wrapping="false" />
                    </t:template>
                </t:Column>
                <t:Column width="8rem">
                    <Label text="Total Price" />
                    <t:template>
                        <Text text="{
                            parts:[{path:'Paymentsum'},{path:'Currency'}],
                            type: 'sap.ui.model.type.Currency',
                            formatOptions: {showMeasure: true }
                            }" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="6rem">
                    <Label text="Planetype" />
                    <t:template>
                        <Text text="{Planetype}" wrapping="false" />
                    </t:template>
                </t:Column>
            </t:columns>
        </t:Table>
    </Page>
</mvc:View>