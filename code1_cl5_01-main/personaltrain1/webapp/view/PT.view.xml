<mvc:View controllerName="code1.cl5.edu.pt.personaltrain1.controller.PT"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:t="sap.ui.table"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">

		<SearchField id="cafen" placeholder="Cofee name" search="scope" />
		<SearchField id="money" placeholder="Price" search="scope" />


        <t:Table
				id="cafe_menu"
				rows="{coffee>/CoffeeSet}"
				selectionMode="MultiToggle"
				paste="onPaste"
				ariaLabelledBy="title">
				<t:columns>
					<t:Column width="11rem">
						<Label text="{menu>text1}" />
						<t:template>
							<Text text="{coffee>Label}" wrapping="false" />
						</t:template>
					</t:Column>
					<t:Column width="11rem">
						<Label text="{menu>text2}" />
						<t:template>
							<Text text="{coffee>Sales}" wrapping="false" />
						</t:template>	
					</t:Column>
				</t:columns>
		</t:Table>

    </Page>
</mvc:View>