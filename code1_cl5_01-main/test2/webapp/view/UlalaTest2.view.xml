<mvc:View controllerName="code1.cl5.edu01.test2.controller.UlalaTest2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.suite.ui.microchart"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data">

    <Page id="page" title="{i18n>title}">

    <!-- 2-11 -->
    <VBox>
        <HBox>
            <Label text="단 입력" />
            <Input id="guin211" />
        </HBox>
        <Button text="구구단 출력" press="gubu211" />
    </VBox>

    <!-- 2-12 -->
    <VBox>
        <Button text="짝수 구구단 출력" press="gubu212" />
    </VBox>

    <!-- 2-13 -->
    <VBox>
        <Button text="야구단 출력" press="bu213"/>
    </VBox>

    <!-- 2-14  -->
    <VBox>
        <HBox>
            <SearchField id="year214" width="10em" placeholder="Year" search="onSearch" />
            <SearchField id="area214" width="10em" placeholder="Area" search="onSearch" />
        </HBox>
        <!-- 서치필드 만들었음 -->

        
        <t:Table
            id="base214"
            visibleRowCount="8"
            rows="{ball214>/TeamSet}" 
            selectionMode="Single" 
            selectionBehavior="Row"
            paste="onPaste"
            ariaLabelledBy="title">
            <!-- binding할 수 있게 테이블id 지정 -->

            <t:extension>
                <OverflowToolbar style="Clear">
                    <Title id="BaseBall" text="BaseBall"/>
                </OverflowToolbar>
            </t:extension>
            <t:columns>
                <t:Column width="11rem">
                    <Label text="Team" />
                    <t:template>
                        <Text text="{ball214>Team}" wrapping="false" />
                    </t:template>
                </t:Column>
                <!-- text="{모델의 별칭>Key(필드)}" -->

                <t:Column width="11rem">
                    <Label text="Year" />
                    <t:template>
                        <Text text="{ball214>Year}" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="11rem">
                    <Label text="Area" />
                    <t:template>
                        <Text text="{ball214>Area}" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="11rem">
                    <Label text="Win" />
                    <t:template>
                        <Text text="{ball214>Win}" wrapping="false" />
                    </t:template>
                </t:Column>

                
            </t:columns>	
        </t:Table>
    </VBox>
    <!-- 2-15 -->
    <VBox width="30rem" height="15rem">
        <HBox>
        <!-- 라인차트 데이터를 jsonmodel에서 가져오므로 `="{}"` 형식으로 작성 -->
            <c:InteractiveLineChart points="{ path:'pop215>/popul' }" displayedPoints="10" >
                <c:points>

                    <c:InteractiveLineChartPoint value="{=parseInt(${pop215>home})}"
                                                label="{pop215>Year}" />

                </c:points>
                <!-- value값이 숫자니까 int로 parsing했음. parsing할 때 $를 붙여줘야됨 -->
                
            </c:InteractiveLineChart>
    

            <!-- 막대 차트 -->
            <c:InteractiveBarChart labelWidth="25%" selectionChanged="selectionChanged" bars="{path: 'pop215>/born'}" >
            <!--모범답안: <c:InteractiveBarChart labelWidth="25%" selectionChanged="selectionChanged"
                            bars="{path: 'pop215>/born'}" displayedBars="10" > -->

                <c:bars>
                    <c:InteractiveBarChartBar label="{pop215>Year}"
                                            value="{=parseInt(${pop215>birth})}"
                                            displayedValue="{pop215>birth}" />
                </c:bars>
            </c:InteractiveBarChart>
        </HBox>
    </VBox>

    <!-- 2-16 -->
    <VBox>
        <viz:VizFrame id="idVizFrame" uiConfig="{applicationSet:'fiori'}"
                height='20em' width="30em" vizType='pie'
                vizProperties="{
                title:{text:'비즈차트',
                       visible: false},
                plotArea:{drawingEffect: 'glossy'},
                legend:{drawingEffect: 'glossy'}
                }" >
                <!-- title 안나오게 visible을 false로. plotarea normal말고 glossy -->

                <viz:dataset>
                    <viz.data:FlattenedDataset data="{com216>/GridSet}">
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition name="Gjahr"
                                value="{GridSet>Gjahr}" />
                        </viz.data:dimensions>
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition name="Bukrs"
                                value="{GridSet>Bukrs}" />
                        </viz.data:dimensions>
                        <viz.data:measures>
                            <viz.data:MeasureDefinition name="Anln1"
                                value="{GridSet>Anln1}" />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>
                <!-- Gjahr, Bukrs를 기준(축) 역할을 하는 dimention으로. Anln1를 값 역할을 하는 measure로 -->

                <viz:feeds>
                    <viz.feeds:FeedItem uid="size" type="Measure"
                        values="Anln1" />
                    <viz.feeds:FeedItem uid="color" type="Dimension"
                        values="Bukrs" />
                    <viz.feeds:FeedItem uid="color" type="Dimension"
                        values="Gjahr" />
                </viz:feeds>
                <!-- pie 그래프니까 size와 color로 -->

                <viz:dependents>
                    <viz:Popover id="idPopOver"></viz:Popover>
                </viz:dependents>
            </viz:VizFrame>
    </VBox>
    <VBox>
    <viz:VizFrame id="idVizFrame2" uiConfig="{applicationSet:'fiori'}"
                height='20em' width="30em" vizType='column'
                vizProperties="{
                title:{text:'비즈차트',
                       visible: false},
                plotArea:{drawingEffect: 'glossy'},
                legend:{drawingEffect: 'glossy'}
                }" >
                <viz:dataset>
                    <viz.data:FlattenedDataset data="{com216>/GridSet}">
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition name="Gjahr"
                                value="{GridSet>Gjahr}" />
                        </viz.data:dimensions>
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition name="Bukrs"
                                value="{GridSet>Bukrs}" />
                        </viz.data:dimensions>
                        <viz.data:measures>
                            <viz.data:MeasureDefinition name="Anln1"
                                value="{GridSet>Anln1}" />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                    <viz.feeds:FeedItem uid="valueAxis" type="Measure"
                        values="Anln1" />
                    <viz.feeds:FeedItem uid="categoryAxis" type="Dimension"
                        values="Gjahr" />
                    <viz.feeds:FeedItem uid="categoryAxis" type="Dimension"
                        values="Bukrs" />
                </viz:feeds>
                <!-- 막대 그래프니까 valueAxis와 categoryAxis로  -->

                <viz:dependents>
                    <viz:Popover id="idPopOver2"></viz:Popover>
                </viz:dependents>
            </viz:VizFrame>
    </VBox>
    <VBox>
    <viz:VizFrame id="idVizFrame3" uiConfig="{applicationSet:'fiori'}"
                height='20em' width="30em" vizType='line'
                vizProperties="{
                title:{text:'비즈차트',
                       visible: false},
                plotArea:{drawingEffect: 'glossy'},
                legend:{drawingEffect: 'glossy'}
                }" >
                <viz:dataset>
                    <viz.data:FlattenedDataset data="{com216>/GridSet}">
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition name="Gjahr"
                                value="{GridSet>Gjahr}" />
                        </viz.data:dimensions>
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition name="Bukrs"
                                value="{GridSet>Bukrs}" />
                        </viz.data:dimensions>
                        <viz.data:measures>
                            <viz.data:MeasureDefinition name="Anln1"
                                value="{GridSet>Anln1}" />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                    <viz.feeds:FeedItem uid="valueAxis" type="Measure"
                        values="Anln1" />
                    <viz.feeds:FeedItem uid="categoryAxis" type="Dimension"
                        values="Gjahr" />
                    <viz.feeds:FeedItem uid="categoryAxis" type="Dimension"
                        values="Bukrs" />
                </viz:feeds>
                <viz:dependents>
                    <viz:Popover id="idPopOver3"></viz:Popover>
                </viz:dependents>
            </viz:VizFrame>
    </VBox>


    </Page>
</mvc:View>