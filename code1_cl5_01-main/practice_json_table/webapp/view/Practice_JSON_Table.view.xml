<mvc:View controllerName="practice.json.table.practicejsontable.controller.Practice_JSON_Table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    >
    <Page id="page" title="{i18n>title}">
    
        <t:Table
            rows="{/MatTab}"
            selectionMode="MultiToggle"
            selectionBehavior="RowOnly"
            paste="onPaste"
            ariaLabelledBy="title">

            <t:extension>
                <OverflowToolbar style="Clear">
                    <Title id="title" text="Materials"/>
                </OverflowToolbar>
            </t:extension>

            <t:columns>

                <t:Column width="10rem">
                    <Label text="Matnr" />
                    <t:template>
                        <Text text="{Matnr}" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="7rem">
                    <Label text="Werks" />
                    <t:template hA >
                        <Text text="{Werks}" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="7rem">
                    <Label text="Mtart" />
                    <t:template>
                        <Input value="{Mtart}" />
                    </t:template>
                </t:Column>
  
                <t:Column width="7rem">
                    <Label text="VBELN" />
                    <t:template>
                        <Text text="{VBELN}" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="7rem">
                    <Label text="VBELP" />
                    <t:template>
                        <Text text="{VBELP}" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="7rem">
                    <Label text="PRICE" />
                    <t:template>
                        <Text text="{PRICE}" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="7rem">
                    <Label text="CURRENCY" />
                    <t:template>
                        <Text text="{CURRENCY}" wrapping="false" />
                    </t:template>
                </t:Column>
                
            </t:columns>

        </t:Table>


    </Page>
</mvc:View>